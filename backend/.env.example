# Продакшен-переменные окружения (Railway/Render/Fly) — скопируйте в .env
# Postgres (Neon/Supabase). Оставляете пустым/не задаёте — используется SQLite (dev).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Обязательно смените на случайную строку (openssl rand -hex 32)
SECRET_KEY=replace-me

# Домен(ы) фронта на Vercel, через запятую — без trailing slash
CORS_ORIGINS=https://cafe.vercel.app

# Опционально: Upstash Redis (крос-инстанс pub/sub для live-sync)
REDIS_URL=rediss://default:token@host:6379/0